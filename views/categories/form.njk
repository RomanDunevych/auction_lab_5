{% extends "layout.njk" %}

{% block content %}
{% from "forms.njk" import text, area, actions %}

<div class="page-head">
  <h1>{{ title }}</h1>
</div>

{% include "partials/errors.njk" %}

<form method="post" action="{{ action }}" class="form card narrow" novalidate>
  {{ text('name', 'Назва категорії', values, errors) }}
  {{ area('description', 'Опис', values, errors, rows=3) }}
  {{ actions('/categories') }}
</form>
{% endblock %}
