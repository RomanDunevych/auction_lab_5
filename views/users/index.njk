{% extends "layout.njk" %}

{% block content %}
<div class="page-head">
  <h1>Користувачі</h1>
  <a class="btn btn-primary" href="/users/new">+ Новий користувач</a>
</div>

{% if users.length %}
<table class="table">
  <thead><tr><th>Ім’я</th><th>Email</th><th>Роль</th><th>Лотів</th><th>Ставок</th><th></th></tr></thead>
  <tbody>
    {% for u in users %}
    <tr>
      <td><a href="/users/{{ u.id }}">{{ u.username }}</a></td>
      <td>{{ u.email }}</td>
      <td>{{ 'Адміністратор' if u.role == 'admin' else 'Користувач' }}</td>
      <td>{{ u.lotsForSale | length }}</td>
      <td>{{ u.bids | length }}</td>
      <td class="row-actions">
        <a class="btn btn-small" href="/users/{{ u.id }}/edit">Редагувати</a>
        <form method="post" action="/users/{{ u.id }}/delete" class="inline"
              onsubmit="return confirm('Видалити користувача?');">
          <button class="btn btn-small btn-danger" type="submit">Видалити</button>
        </form>
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<section class="empty-state">
  <h2>Користувачів ще немає</h2>
  <p><a class="btn btn-primary" href="/users/new">Додати користувача</a></p>
</section>
{% endif %}
{% endblock %}
