{% extends "layout.njk" %}

{% block content %}
{% from "forms.njk" import text, actions %}

<div class="page-head">
  <h1>{{ title }}</h1>
</div>

{% include "partials/errors.njk" %}

<form method="post" action="{{ action }}" class="form card narrow" novalidate>
  {{ text('name', 'Код статусу', values, errors, hint='Малі латинські літери, цифри та _, наприклад: on_hold') }}
  {{ actions('/statuses') }}
</form>
{% endblock %}
